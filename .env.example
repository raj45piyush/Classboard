# ClassBoard — Firebase Web App Configuration
#
# Copy this file to `.env` and fill in the REAL values from:
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
#
# Do NOT commit the real .env file. It is already listed in .gitignore.
# Do NOT put any server-only secret (service account key, admin private key) in here.
# Everything in a Vite `VITE_`-prefixed variable is shipped to the browser.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Realtime Database URL, e.g. https://<project-id>-default-rtdb.<region>.firebasedatabase.app
# You must explicitly create a Realtime Database instance in the Firebase console
# (Build -> Realtime Database -> Create Database) to get this URL.
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_FUNCTIONS_ENABLED=false
